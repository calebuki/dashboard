{
  "name": "dashboard-desktop",
  "version": "0.2.0",
  "description": "A calm, always-on-top Mac and Windows dashboard with offline-first cross-computer sync.",
  "author": "Caleb Uki",
  "license": "MIT",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/calebuki/dashboard",
  "repository": {
    "type": "git",
    "url": "https://github.com/calebuki/dashboard.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run icons && npm run build && electron-builder --win nsis --publish never",
    "build:mac": "npm run icons && npm run build && electron-builder --mac dmg zip --universal --publish never",
    "icons": "node scripts/generate-icon.mjs",
    "preview": "electron-vite preview",
    "smoke:ui": "node scripts/ui-smoke.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/flubber": "0.4.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.calebuki.dashboard",
    "productName": "Dashboard",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Dashboard-Setup-${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "artifactName": "Dashboard-${version}-mac-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Dashboard ${version}",
      "artifactName": "Dashboard-${version}-mac-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dashboard"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "calebuki",
        "repo": "dashboard"
      }
    ]
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.4",
    "@supabase/supabase-js": "2.112.4",
    "chrono-node": "2.10.1",
    "clsx": "2.1.1",
    "figma-squircle": "1.1.0",
    "flubber": "0.4.2",
    "motion": "13.1.1",
    "react-use-measure": "2.1.7",
    "tailwind-merge": "3.3.1"
  }
}
