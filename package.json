{
  "name": "dashboard-desktop",
  "version": "0.1.0",
  "description": "A calm, always-on-top Windows dashboard for immediate tasks and long-term goals.",
  "author": "Caleb Uki",
  "license": "MIT",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/calebuki/dashboard",
  "repository": {
    "type": "git",
    "url": "https://github.com/calebuki/dashboard.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run icons && npm run build && electron-builder --win nsis",
    "icons": "node scripts/generate-icon.mjs",
    "preview": "electron-vite preview",
    "smoke:ui": "node scripts/ui-smoke.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.calebuki.dashboard",
    "productName": "Dashboard",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Dashboard-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dashboard"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "calebuki",
        "repo": "dashboard"
      }
    ]
  }
}
